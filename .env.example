# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Study Assistant, Topic Explainer, Quiz & Notes Generators).
# Never exposed to client-side code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL where the application is hosted.
APP_URL="http://localhost:3000"

# AUTH_SECRET: Secret key used to sign session tokens on the backend.
AUTH_SECRET="replace_with_a_strong_32_char_random_secret"

# ADMIN CREDENTIALS: Optional pre-configured administrator login credentials.
# If omitted, the first administrator can be initialized securely via the one-time Admin Setup screen.
ADMIN_EMAIL="admin@university.edu"
ADMIN_PASSWORD="ChangeMeStrongPassword123!"

# SUPABASE POSTGRESQL CONFIGURATION (Optional for cloud PostgreSQL persistence; falls back to local persistent relational store if unset)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
